{
  "expo": {
    "name": "TMM Academy",
    "slug": "tmm-academy-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "androidStatusBar": {
      "translucent": true,
      "backgroundColor": "#00000000"
    },
    "androidNavigationBar": {
      "barStyle": "light-content",
      "backgroundColor": "#0f172a",
      "visible": "always"
    },
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0f172a"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tmminnovation.academy",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Allow TMM Academy to use Face ID for fast and secure authentication."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0f172a"
      },
      "package": "com.tmminnovation.academy"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-sharing",
      [
        "expo-navigation-bar",
        {
          "enforceContrast": false
        }
      ]
    ]
  }
}
